# CIVENTRAL - Environment Variables
# Copy this file to .env and fill in your actual values


# Application Settings
APP_ENV=development
APP_DEBUG=true

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Remote API Base URLs (no local database used)
EXPO_PUBLIC_API_BASE_URL=https://civentral.tech/api/employee
API_BASE_URL_CITIZEN=https://civentral.tech/api/citizen

# Local database used by the PHP service pages
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civentral_local
DB_USER=root
DB_PASSWORD=
